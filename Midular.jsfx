desc:Midular - MIDI sampler (classic / one-shot / slice / granular)
tags: MIDI sampler slicer granular instrument
//
// Midular turns a MIDI phrase into a playable instrument, the way Simpler or
// Bitwig's Sampler turn an audio file into one - except every stage of the
// signal path works on notes instead of samples.
//
//   Classic    polyphonic; each held key loops the phrase
//   One-Shot   monophonic; one trigger plays the phrase start to finish
//   Slice      chops the phrase and maps the pieces across the keyboard
//   Granular   up to 256 independent grains with their own motion and direction
//
// Phrases are imported with Scripts/midular_import.lua, which hands them over
// through gmem (see md_ticket_poll), and are saved inside the project.  The
// Source File slider - .txt files in <REAPER resource path>/Data/midular/ -
// remains as a fallback.  See README.md and docs/FORMAT.md.
//
// Copyright (C) 2026  Midular contributors.
// Licensed under the GNU General Public License v3 (see LICENSE).

in_pin:none
out_pin:none
options:no_meter gfx_hz=30 gmem=Midular

// --- source -----------------------------------------------------------------
slider1:/midular:default.txt:Source File

// --- play -------------------------------------------------------------------
slider2:0<0,3,1{Classic,One-Shot,Slice,Granular}>-Mode
slider3:60<0,127,1>-Root Key
slider4:0<-48,48,1>-Transpose
slider5:1<0,2,1{Off,Transpose,Rate (Pitch)}>-Key Tracking
slider6:8<1,16,1>-Polyphony
slider7:2<0,2,1{Source,Played Key,Blend}>-Velocity Source
slider8:100<0,200,1>-Velocity Scale
slider9:100<1,400,1>-Note Length
slider10:0<0,16,1>-Output Channel
slider11:0<0,60,0.1>-Humanize Timing
slider12:0<0,48,1>-Humanize Velocity
slider13:0<0,1,1{Off,On}>-MIDI Thru

// --- warp -------------------------------------------------------------------
slider14:1<0,2,1{Free (Source Tempo),Sync (Project),Fixed Length}>-Warp Mode
slider15:1<0.0625,8,0.0001>-Speed
slider16:4<0.25,64,0.25>-Fixed Length
slider17:0<0,1,1{Retrigger,Transport Lock}>-Start Mode
slider18:0<0,5,1{Off,1/16,1/8,1/4,1/2,1 Bar}>-Trigger Quantize
slider19:0<0,99,0.01>-Region Start
slider20:100<1,100,0.01>-Region Length
slider21:0<0,1,1{Off,On}>-Reverse

// --- loop -------------------------------------------------------------------
slider22:1<0,1,1{Off,On}>-Loop
slider23:0<0,2,1{Forward,Reverse,Ping-Pong}>-Loop Mode
slider24:0<0,99,0.01>-Loop Start
slider25:100<1,100,0.01>-Loop Length
slider26:0<0,64,1>-Loop Count

// --- amplitude envelope -----------------------------------------------------
slider27:0<0,5000,1>-Attack
slider28:500<0,10000,1>-Decay
slider29:100<0,100,0.1>-Sustain
slider30:80<0,10000,1>-Release
slider31:100<0,100,0.1>-Envelope Amount
slider32:0<-1,1,0.01>-Envelope Curve

// --- note filter ------------------------------------------------------------
slider33:0<0,4,1{Off,Lowpass,Highpass,Bandpass,Notch}>-Filter Mode
slider34:64<0,127,0.1>-Filter Cutoff
slider35:24<0.5,60,0.1>-Filter Width
slider36:12<0,48,0.1>-Filter Slope
slider37:0<0,100,0.1>-Filter Resonance
slider38:0<-100,100,1>-Filter Key Tracking
slider39:5<0,100,1>-Filter Threshold

// --- slice ------------------------------------------------------------------
slider40:0<0,4,1{Divisions,Beats,Onsets,Pitch Changes,Manual Markers}>-Slice Method
slider41:16<1,128,1>-Slice Divisions
slider42:1<0,6,1{1/32,1/16,1/8,1/4,1/2,1 Bar,2 Bars}>-Slice Grid
slider43:50<0,100,1>-Onset Sensitivity
slider44:36<0,127,1>-Slice Map Root
slider45:0<0,1,1{Until Slice End,While Held}>-Slice Gate

// --- granular ---------------------------------------------------------------
slider46:4<1,256,1>-Grain Count
slider47:1<0.01,8,0.001>-Grain Size
slider48:20<0,100,0.1>-Grain Spray
slider49:0<-4,4,0.001>-Grain Motion
slider50:0<0,3,1{Forward,Reverse,Alternate,Random}>-Grain Direction
slider51:100<1,100,1>-Grain Density
slider52:0<0,24,1>-Grain Pitch Spread
slider53:2<0,2,1{Even,Random,Cloud}>-Grain Spread
slider54:1<1,999,1>-Grain Seed

// --- mono behaviour ---------------------------------------------------------
slider55:0<0,2,1{Restart,Ignore While Playing,Legato}>-One-Shot Retrigger
slider56:0<0,1,1{Off,On}>-Mono Choke

// --- internal -----------------------------------------------------------------
// Written by midular_import.lua (TrackFX_SetParam) to address a phrase waiting
// in the gmem mailbox to this instance.  Not a control; no panel cell.
slider57:0<0,1000000,1>-Import Ticket

import midular_core.jsfx-inc
import midular_engine.jsfx-inc
import midular_ui.jsfx-inc

@init

ext_noinit = 1;

// ---------------------------------------------------------------------------
// Parameter fan-out.  Called every block so that changes made from @gfx take
// effect even if the host does not re-run @slider.
// ---------------------------------------------------------------------------
function md_apply_params() local(span, h)
(
  p_mode      = slider2 | 0;
  p_root      = slider3 | 0;
  p_transp    = slider4 | 0;
  p_keytrack  = slider5 | 0;
  p_poly      = max(slider6 | 0, 1);
  p_velmode   = slider7 | 0;
  p_velamt    = slider8;
  p_gate      = slider9;
  p_outchan   = slider10 | 0;
  p_humt      = slider11;
  p_humv      = slider12;
  p_thru      = slider13 | 0;

  p_warp      = slider14 | 0;
  p_speed     = max(slider15, 0.0001);
  p_fixlen    = max(slider16, 0.01);
  p_startmode = slider17 | 0;
  p_tquant    = slider18 | 0;
  p_srcstart  = slider19;
  p_srclen    = slider20;
  p_reverse   = slider21 | 0;

  p_loopon    = slider22 | 0;
  p_loopmode  = slider23 | 0;
  p_loopstart = slider24;
  p_looplen   = slider25;
  p_loopcnt   = slider26 | 0;

  p_atk       = slider27;
  p_dec       = slider28;
  p_sus       = slider29;
  p_rel       = slider30;
  p_envamt    = slider31;
  p_envcurve  = slider32;

  p_fmode     = slider33 | 0;
  p_fcut      = slider34;
  p_fwidth    = slider35;
  p_fslope    = slider36;
  p_freso     = slider37;
  p_fkey      = slider38;
  p_fthresh   = slider39;

  p_slmethod  = slider40 | 0;
  p_sldiv     = slider41 | 0;
  p_slgrid    = slider42 | 0;
  p_slsens    = slider43;
  p_slroot    = slider44 | 0;
  p_slgate    = slider45 | 0;

  p_gcount    = slider46 | 0;
  p_gsize     = slider47;
  p_gspray    = slider48;
  p_gmotion   = slider49;
  p_gdir      = slider50 | 0;
  p_gdens     = slider51;
  p_gpitch    = slider52 | 0;
  p_gshape    = slider53 | 0;
  p_gseed     = slider54 | 0;

  p_osretrig  = slider55 | 0;
  p_choke     = slider56 | 0;

  // playback region and loop bounds, in source beats
  md_reg_a = md_src_len * p_srcstart * 0.01;
  md_reg_b = min(md_reg_a + md_src_len * p_srclen * 0.01, md_src_len);
  md_reg_b - md_reg_a < 0.0001 ? md_reg_b = min(md_reg_a + 0.0001, md_src_len);
  span = max(md_reg_b - md_reg_a, 0.0001);

  md_loop_a = md_reg_a + span * p_loopstart * 0.01;
  md_loop_b = min(md_loop_a + span * p_looplen * 0.01, md_reg_b);
  md_loop_a = min(md_loop_a, md_loop_b - 0.0001);
  md_loop_a < md_reg_a ? md_loop_a = md_reg_a;

  md_ratio     = md_warp_ratio();      // cached: `tempo` is not valid in @gfx
  md_base_rate = md_bps * md_ratio;

  // rebuild the slice map only when something it depends on actually moved
  h = p_slmethod * 10000000 + p_sldiv * 10000 + p_slgrid * 1000 + p_slsens * 3 +
      md_reg_a * 7.13 + md_reg_b * 13.7 + md_nmark * 31 + md_src_n * 0.077 + md_src_len * 0.31;
  (h != md_slice_hash || md_slice_dirty) ? (
    md_slice_hash  = h;
    md_slice_dirty = 0;
    md_build_slices(md_reg_a, md_reg_b, p_slmethod, p_sldiv, p_slgrid, p_slsens);
  );
);

// ---------------------------------------------------------------------------
// Control panel layout
// ---------------------------------------------------------------------------
function md_build_ui()
(
  md_nctl = 0;

  // ---- page 1: PLAY --------------------------------------------------------
  md_ctl_cell(CT_SELECT,  2, 0,   0, 3,   1, 0, 0, 1, "Mode",        "Classic|One-Shot|Slice|Granular");
  md_ctl_cell(CT_KNOB,    3, 60,  0, 127, 1, 1, 0, 1, "Root Key",    "note %d");
  md_ctl_cell(CT_KNOB,    4, 0, -48, 48,  1, 2, 0, 1, "Transpose",   "%+d semitones");
  md_ctl_cell(CT_SELECT,  5, 1,   0, 2,   1, 3, 0, 1, "Key Tracking", "Off|Transpose|Rate");
  md_ctl_cell(CT_KNOB,    6, 8,   1, 16,  1, 4, 0, 1, "Polyphony",   "%d");
  md_ctl_cell(CT_SELECT,  7, 2,   0, 2,   1, 5, 0, 1, "Velocity",    "Source|Played Key|Blend");
  md_ctl_cell(CT_KNOB,    8, 100, 0, 200, 1, 6, 0, 1, "Velocity Scale",   "%d %%");

  md_ctl_cell(CT_KNOB,    9, 100, 1, 400, 1, 0, 1, 1, "Note Length", "%d %%");
  md_ctl_cell(CT_KNOB,   10, 0,   0, 16,  1, 1, 1, 1, "Output Channel", "%d");
  md_ctl_cell(CT_KNOB,   11, 0,   0, 60, 0.1,2, 1, 1, "Humanize Timing",  "%.1f ms");
  md_ctl_cell(CT_KNOB,   12, 0,   0, 48,  1, 3, 1, 1, "Humanize Velocity",   "%d");
  md_ctl_cell(CT_TOGGLE, 13, 0,   0, 1,   1, 4, 1, 1, "MIDI Thru",   "Off|On");
  md_ctl_cell(CT_SELECT, 55, 0,   0, 2,   1, 5, 1, 1, "Retrigger",   "Restart|Ignore|Legato");
  md_ctl_cell(CT_TOGGLE, 56, 0,   0, 1,   1, 6, 1, 1, "Mono Choke",  "Off|On");

  // ---- page 2: WARP + LOOP -------------------------------------------------
  md_ctl_cell(CT_SELECT, 14, 1,   0, 2,   1, 0, 0, 2, "Warp Mode",        "Free|Sync|Fixed Length");
  md_ctl_cell(CT_KNOB,   15, 1, 0.0625, 8, 0.0001, 1, 0, 2, "Speed", "×%.3f");
  md_ctl_cell(CT_KNOB,   16, 4, 0.25, 64, 0.25, 2, 0, 2, "Fixed Length", "%.2f beats");
  md_ctl_cell(CT_SELECT, 17, 0,   0, 1,   1, 3, 0, 2, "Start Mode",       "Retrigger|Transport Lock");
  md_ctl_cell(CT_SELECT, 18, 0,   0, 5,   1, 4, 0, 2, "Trigger Quantize",  "Off|1/16|1/8|1/4|1/2|1 Bar");
  md_ctl_cell(CT_KNOB,   19, 0,   0, 99, 0.01, 5, 0, 2, "Region Start", "%.2f %%");
  md_ctl_cell(CT_KNOB,   20, 100, 1, 100, 0.01, 6, 0, 2, "Region Length", "%.2f %%");

  md_ctl_cell(CT_TOGGLE, 21, 0,   0, 1,   1, 0, 1, 2, "Reverse",     "Off|On");
  md_ctl_cell(CT_TOGGLE, 22, 1,   0, 1,   1, 1, 1, 2, "Loop",        "Off|On");
  md_ctl_cell(CT_SELECT, 23, 0,   0, 2,   1, 2, 1, 2, "Loop Mode",   "Forward|Reverse|Ping-Pong");
  md_ctl_cell(CT_KNOB,   24, 0,   0, 99, 0.01, 3, 1, 2, "Loop Start", "%.2f %%");
  md_ctl_cell(CT_KNOB,   25, 100, 1, 100, 0.01, 4, 1, 2, "Loop Length", "%.2f %%");
  md_ctl_cell(CT_KNOB,   26, 0,   0, 64,  1, 5, 1, 2, "Loop Count",  "%d");

  // ---- page 3: AMP + FILTER ------------------------------------------------
  md_ctl_cell(CT_KNOB,   27, 0,   0, 5000, 1, 0, 0, 3, "Attack",     "%d ms");
  md_ctl_cell(CT_KNOB,   28, 500, 0, 10000, 1, 1, 0, 3, "Decay",     "%d ms");
  md_ctl_cell(CT_KNOB,   29, 100, 0, 100, 0.1, 2, 0, 3, "Sustain",   "%.1f %%");
  md_ctl_cell(CT_KNOB,   30, 80,  0, 10000, 1, 3, 0, 3, "Release",   "%d ms");
  md_ctl_cell(CT_KNOB,   31, 100, 0, 100, 0.1, 4, 0, 3, "Envelope Amount","%.1f %%");
  md_ctl_cell(CT_KNOB,   32, 0,  -1, 1, 0.01, 5, 0, 3, "Envelope Curve",  "%+.2f");

  md_ctl_cell(CT_SELECT, 33, 0,   0, 4,   1, 0, 1, 3, "Filter",      "Off|Lowpass|Highpass|Bandpass|Notch");
  md_ctl_cell(CT_KNOB,   34, 64,  0, 127, 0.1, 1, 1, 3, "Cutoff",    "note %.0f");
  md_ctl_cell(CT_KNOB,   35, 24, 0.5, 60, 0.1, 2, 1, 3, "Width",     "%.1f semitones");
  md_ctl_cell(CT_KNOB,   36, 12,  0, 48, 0.1, 3, 1, 3, "Slope",      "%.1f semitones");
  md_ctl_cell(CT_KNOB,   37, 0,   0, 100, 0.1, 4, 1, 3, "Resonance", "%.1f %%");
  md_ctl_cell(CT_KNOB,   38, 0,-100, 100, 1, 5, 1, 3, "Key Tracking", "%+d %%");
  md_ctl_cell(CT_KNOB,   39, 5,   0, 100, 1, 6, 1, 3, "Threshold",   "%d %%");

  // ---- page 4: SLICE -------------------------------------------------------
  md_ctl_cell(CT_SELECT, 40, 0,   0, 4,   1, 0, 0, 4, "Method",      "Divisions|Beats|Onsets|Pitch Changes|Manual Markers");
  md_ctl_cell(CT_KNOB,   41, 16,  1, 128, 1, 1, 0, 4, "Divisions",   "%d");
  md_ctl_cell(CT_SELECT, 42, 1,   0, 6,   1, 2, 0, 4, "Grid",        "1/32|1/16|1/8|1/4|1/2|1 Bar|2 Bars");
  md_ctl_cell(CT_KNOB,   43, 50,  0, 100, 1, 3, 0, 4, "Sensitivity", "%d %%");
  md_ctl_cell(CT_KNOB,   44, 36,  0, 127, 1, 4, 0, 4, "Map Root",    "note %d");
  md_ctl_cell(CT_SELECT, 45, 0,   0, 1,   1, 5, 0, 4, "Gate",        "Until Slice End|While Held");

  // ---- page 5: GRANULAR ----------------------------------------------------
  md_ctl_cell(CT_KNOB,   46, 16,  1, 256, 1, 0, 0, 5, "Grains",      "%d");
  md_ctl_cell(CT_KNOB,   47, 0.25, 0.01, 8, 0.001, 1, 0, 5, "Size",  "%.3f beats");
  md_ctl_cell(CT_KNOB,   48, 0,   0, 100, 0.1, 2, 0, 5, "Spray",     "%.1f %%");
  md_ctl_cell(CT_KNOB,   49, 0,  -4, 4, 0.001, 3, 0, 5, "Motion",    "%+.3f");
  md_ctl_cell(CT_SELECT, 50, 0,   0, 3,   1, 4, 0, 5, "Direction",   "Forward|Reverse|Alternate|Random");
  md_ctl_cell(CT_KNOB,   51, 100, 1, 100, 1, 5, 0, 5, "Density",     "%d %%");
  md_ctl_cell(CT_KNOB,   52, 0,   0, 24,  1, 6, 0, 5, "Pitch Spread","%d semitones");

  md_ctl_cell(CT_SELECT, 53, 0,   0, 2,   1, 0, 1, 5, "Spread",      "Even|Random|Cloud");
  md_ctl_cell(CT_KNOB,   54, 1,   1, 999, 1, 1, 1, 5, "Seed",        "%d");
);

function md_reset_state() local(i)
(
  i = 0; while (i < MAX_VOICES) ( VOICES[i * V_STRIDE + V_STATE] = 0; i += 1; );
  i = 0; while (i < MAX_GRAINS) ( GRAINS[i * G_STRIDE + G_OWNER] = 0; i += 1; );
  i = 0; while (i < MAX_VOICES + MAX_GRAINS) ( STREAMS[i * S_STRIDE + S_ACTIVE] = 0; i += 1; );
  i = 0;
  while (i < MAX_SOUND) (
    SOUND[i * N_STRIDE + N_USED] = 0;
    SOUND[i * N_STRIDE + N_KEY]  = -1;
    SOUND[i * N_STRIDE + N_OWNER] = -1;
    i += 1;
  );
  memset(SOUNDMAP, 0, 2048);
  md_pend_drop(-1);        // owner 0 is a real voice, so free slots must be -1
  md_sustain = 0;
);

md_init_consts();
md_ui_consts();
md_build_ui();
md_reset_state();

md_now        = 0;
md_agecnt     = 1;
md_srate      = srate;
md_bps        = 120 / 60 / max(srate, 1);
md_blk_len    = 0;
md_ts_num     = 4;
md_ts_den     = 4;
md_lastfile   = -1;
md_lastplay   = 0;
md_reload     = 1;
md_slice_dirty = 1;
md_src_n      = 0;
md_src_len    = 4;
md_src_tempo  = 120;
md_src_tsnum  = 4;
md_src_tsden  = 4;
md_nmark      = 0;
md_nslices    = 0;
md_slice_hash = -1;
md_scanning   = 0;
// Deliberately NOT initialised here: md_stage_ready, md_ticket_seen,
// md_mark_edited, md_restore_left, md_ser_*.  @serialize can run before
// @init, and these carry what it restored.  Globals start at 0 anyway.
strcpy(#md_name, "(no source)");

@slider

// Parameter fan-out happens in @block (so UI-driven changes apply even when the
// host does not re-run this section); all that is needed here is to invalidate
// the cached slice map.
md_slice_dirty = 1;
md_ticket_poll(slider57);   // TrackFX_SetParam lands here even with no audio

@block

srate != md_srate ? ( md_srate = srate; md_reset_state(); );

md_blk_start = md_now;
md_blk_len   = samplesblock;
md_blk_beat  = beat_position;
md_ts_num    = max(ts_num, 1);
md_ts_den    = max(ts_denom, 1);
md_bps       = max(tempo, 1) / 60 / max(srate, 1);
md_playing   = play_state == 1 || play_state == 5;    // playing or recording

// ---- transport ------------------------------------------------------------
play_state != md_lastplay ? (
  ((md_lastplay == 1 || md_lastplay == 5) && play_state != 1 && play_state != 5) ? md_panic(0);
  md_lastplay = play_state;
);

// ---- the phrase -------------------------------------------------------------
// 1. A phrase handed over by the importer (Import Ticket + gmem) or restored by
//    @serialize waits in STAGE.  Installing it is the audio thread's job.
md_ticket_poll(slider57);
md_stage_ready ? (
  md_stage_ready = 0;
  md_panic(0);
  md_install_stage() ? md_reload = 1;
);

// 2. The Source File slider (fallback route).  md_scanning: the GUI is stepping
//    slider1 to list the files (md_scan_files); those values are not a choice.
md_load_file = md_reload && md_src_kind != 2;     // an embedded phrase has no file
(slider1 != md_lastfile && !md_scanning) ? (
  (md_lastfile >= 0 && md_restore_left <= 0) ? (
    // the user picked a file: it replaces the phrase, edited markers and all
    md_mark_edited = 0;
    md_load_file = 1;
  ) : (
    // first look, or slider1 arriving with a restored project/undo state: a
    // phrase the state carried wins; otherwise (version 1 state, or none) the
    // file is the phrase.  Edited markers are kept either way.
    md_src_kind != 2 ? md_load_file = 1;
  );
  md_lastfile = slider1;
);
md_restore_left > 0 ? md_restore_left -= samplesblock;
md_load_file ? (
  md_panic(0);
  md_fh = file_open(slider1);
  md_fh >= 0 ? (
    md_load_handle(md_fh) ? ( strcpy_fromslider(#md_name, slider1); md_src_kind = 1; )
                          : md_make_default();
    file_close(md_fh);
  ) : md_make_default();
  md_sync_cur();
);
(md_load_file || md_reload) ? ( md_apply_markers(); md_slice_dirty = 1; );
md_reload = 0;

md_apply_params();

// ---- MIDI input -----------------------------------------------------------
while (midirecv(md_off, md_m1, md_m2, md_m3)) (
  md_st = md_m1 & $xF0;
  md_ch = md_m1 & $x0F;
  md_t  = md_blk_start + md_off;

  (md_st == $x90 && md_m3 > 0) ? (
    md_trigger(md_m2, md_m3, md_ch, md_t);
    p_thru ? midisend(md_off, md_m1, md_m2, md_m3);
  ) :
  (md_st == $x80 || (md_st == $x90 && md_m3 == 0)) ? (
    md_note_off(md_m2, md_ch, md_t);
    p_thru ? midisend(md_off, md_m1, md_m2, md_m3);
  ) :
  (md_st == $xB0 && md_m2 == 64) ? (
    // consumed, not passed on: the instrument downstream would otherwise
    // sustain every generated note as well and smear the phrase
    md_m3 >= 64 ? md_sustain = 1 : ( md_sustain = 0; md_sustain_off(md_t); );
  ) :
  (md_st == $xB0 && (md_m2 == 120 || md_m2 == 123)) ? (
    md_panic(md_off);
    midisend(md_off, md_m1, md_m2, md_m3);
  ) :
  midisend(md_off, md_m1, md_m2, md_m3);
);

// ---- render ---------------------------------------------------------------
md_render_block();
md_now += samplesblock;

@serialize

// Version 2 also stores the phrase, so a project plays the same anywhere - it
// no longer depends on a file in Data/midular/ (or on that file keeping its
// position in the folder list, which is what the file slider really saves).
//
//   ver, markersEdited, nEditedMarkers, editedMarkers[],
//   ticketSeen, hasPhrase, [phrase block: 7 header values, markers, name, notes]
//
// Version 1 stopped after editedMarkers; it still loads.
md_init_consts();
md_ser_avail = file_avail(0);
md_ser_avail >= 3 ? (
  file_var(0, md_ser_ver);
  file_var(0, md_mark_edited);
  file_var(0, md_ser_nmark);
  md_ser_nmark = md_clamp(md_ser_nmark | 0, 0, MAX_MARKERS);
  md_ser_nmark > 0 ? file_mem(0, MARKERS_SV, md_ser_nmark);
  md_ser_ver >= 2 ? (
    file_var(0, md_ticket_seen);   // so the restored Import Ticket isn't a new request
    file_var(0, md_ser_has);
    md_ser_has ? (
      md_ser_block(STAGE, STAGE + PB_NOTES, 1);
      md_stage_ready = STAGE[PB_N] > 0;
    );
  );
  md_reload = 1;
  // REAPER restores slider1 alongside this state, possibly a block or two
  // apart; for a moment its changes are part of the restore, not a user pick
  md_restore_left = 0.3 * (md_srate > 0 ? md_srate : 48000);
) : (
  md_ser_avail < 0 ? (
    // MARKERS_SV / md_ser_nmark are kept in step with every edit by
    // md_markers_edited(), so a reload between edits and a save keeps them too
    md_ser_ver = 2;
    md_ser_nmark = md_mark_edited ? md_clamp(md_ser_nmark | 0, 0, MAX_MARKERS) : 0;
    file_var(0, md_ser_ver);
    file_var(0, md_mark_edited);
    file_var(0, md_ser_nmark);
    md_ser_nmark > 0 ? file_mem(0, MARKERS_SV, md_ser_nmark);
    file_var(0, md_ticket_seen);
    // A phrase still waiting in STAGE is the one that is about to play, so save
    // that (the importer's undo point can be taken before @block installs it).
    md_ser_pb    = md_stage_ready ? STAGE : CURHDR;
    md_ser_notes = md_stage_ready ? STAGE + PB_NOTES : BUF_NOTES;
    md_ser_has   = (md_stage_ready || md_src_kind >= 1) && md_ser_pb[PB_N] > 0;
    file_var(0, md_ser_has);
    md_ser_has ? md_ser_block(md_ser_pb, md_ser_notes, 0);
  );
);

@gfx 920 600

gfx_getchar();
md_ui_mouse();
md_ui_draw();
